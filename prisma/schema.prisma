generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SourcingRule {
  id String @id @default(cuid())

  brand      String
  model      String
  yearMin    Int?
  yearMax    Int?
  priceMax   Float?
  mileageMax Int?

  countries String[] @default([])
  sources   String[] @default([])

  isActive Boolean @default(true)

  listings VehicleListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleListing {
  id String @id @default(cuid())

  source     String
  sourceUrl  String  @unique
  externalId String?

  brand       String
  model       String
  version     String?
  title       String?
  description String?

  year     Int?
  mileage  Int?
  price    Float?
  currency String @default("EUR")

  fuel         String?
  transmission String?
  power        String?
  location     String?
  country      String?

  imageUrl String?

  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  lastCheckedAt DateTime?

  isActive       Boolean               @default(true)
  internalStatus VehicleInternalStatus @default(NEW)

  sourcingRuleId String?
  sourcingRule   SourcingRule? @relation(fields: [sourcingRuleId], references: [id])

  analysis      VehicleAnalysis?
  dealerVehicle DealerVehicle?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleAnalysis {
  id String @id @default(cuid())

  listingId String         @unique
  listing   VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  purchaseTargetPrice Float?
  negotiationPrice    Float?

  repairCostEstimate Float?
  transportCost      Float?
  customsCost        Float?
  otherCosts         Float?

  expectedSalePrice Float?
  expectedMargin    Float?
  marginRate        Float?

  plannedWorks String?
  notes        String?

  priorityScore Int?
  isFavorite    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GarageRequest {
  id String @id @default(cuid())

  firstName String?
  lastName  String?
  email     String?
  phone     String?

  vehicleBrand String?
  vehicleModel String?
  vehicleYear  Int?
  mileage      Int?
  plateNumber  String?

  problemType String?
  symptoms    String[]
  description String?

  preferredContactMethod String?
  preferredDate          DateTime?

  status   GarageRequestStatus   @default(NEW)
  priority GarageRequestPriority @default(NORMAL)
  source   String?               @default("website")

  quoteTotal Float?
  quoteNote  String?

  mechanicNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interventions GarageInterventionLine[]
}

model DealerVehicle {
  id String @id @default(cuid())

  sourcingListingId String? @unique

  stockReference String @unique

  sourceUrl String?
  source    String?

  brand   String
  model   String
  version String?
  title   String?

  year     Int?
  mileage  Int?
  price    Float?
  currency String @default("EUR")

  fuel         String?
  transmission String?
  power        String?
  location     String?
  country      String?
  imageUrl     String?

  description String?
  dealerNotes String?

  status DealerVehicleStatus @default(AVAILABLE)

  isFeatured Boolean @default(false)
  sortOrder  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourcingListing VehicleListing? @relation(fields: [sourcingListingId], references: [id], onDelete: SetNull)
}

model InterventionCode {
  id String @id @default(cuid())

  code             String  @unique
  label            String
  category         String
  description      String?
  unitPrice        Float
  defaultQty       Float   @default(1)
  estimatedMinutes Int?
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         GarageInterventionLine[]
  externalLines ExternalMaintenanceInterventionLine[]
}

model GarageInterventionLine {
  id String @id @default(cuid())

  garageRequestId    String
  interventionCodeId String?

  code      String?
  label     String
  category  String?
  qty       Float   @default(1)
  unitPrice Float
  total     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garageRequest    GarageRequest     @relation(fields: [garageRequestId], references: [id], onDelete: Cascade)
  interventionCode InterventionCode? @relation(fields: [interventionCodeId], references: [id])
}

model ExternalMaintenanceRequest {
  id String @id @default(cuid())

  sourceCompany ExternalMaintenanceSourceCompany
  sourceSystem  String

  externalRequestId String
  externalVehicleId String?

  vehicleType ExternalMaintenanceVehicleType
  plateNumber String?

  interventionType ExternalMaintenanceInterventionType
  urgency          ExternalMaintenanceUrgency          @default(NORMAL)
  status           ExternalMaintenanceStatus           @default(RECEIVED)

  mileage                Int?
  immobilizationRequired Boolean   @default(false)
  preferredDate          DateTime?

  issueDescription String
  internalNotes    String?

  quoteAmount   Float?
  invoiceAmount Float?

  quotePdfUrl   String?
  invoicePdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory     ExternalMaintenanceStatusHistory[]
  webhookDeliveries ExternalMaintenanceWebhookDelivery[]
  interventionLines ExternalMaintenanceInterventionLine[]

  @@unique([sourceCompany, externalRequestId])
  @@index([sourceCompany])
  @@index([externalRequestId])
  @@index([status])
  @@index([plateNumber])
  @@index([urgency])
}

model ExternalMaintenanceInterventionLine {
  id String @id @default(cuid())

  externalMaintenanceRequestId String
  interventionCodeId           String?

  code        String?
  label       String
  description String?
  qty         Float   @default(1)
  unitPrice   Float
  total       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalMaintenanceRequest ExternalMaintenanceRequest @relation(fields: [externalMaintenanceRequestId], references: [id], onDelete: Cascade)
  interventionCode           InterventionCode?          @relation(fields: [interventionCodeId], references: [id])

  @@index([externalMaintenanceRequestId])
}

model ExternalMaintenanceStatusHistory {
  id String @id @default(cuid())

  externalMaintenanceRequestId String
  oldStatus                    ExternalMaintenanceStatus?
  newStatus                    ExternalMaintenanceStatus
  comment                      String?
  createdAt                    DateTime                   @default(now())

  externalMaintenanceRequest ExternalMaintenanceRequest @relation(fields: [externalMaintenanceRequestId], references: [id], onDelete: Cascade)

  @@index([externalMaintenanceRequestId])
  @@index([newStatus])
  @@index([createdAt])
}

model ExternalMaintenanceWebhookDelivery {
  id String @id @default(cuid())

  externalMaintenanceRequestId String
  targetSystem                 ExternalMaintenanceWebhookTarget         @default(NOVOTRALUX)
  eventType                    String
  payloadJson                  Json
  status                       ExternalMaintenanceWebhookDeliveryStatus @default(PENDING)
  httpStatus                   Int?
  responseBody                 String?
  errorMessage                 String?
  attempts                     Int                                      @default(0)
  lastAttemptAt                DateTime?
  deliveredAt                  DateTime?
  createdAt                    DateTime                                 @default(now())
  updatedAt                    DateTime                                 @updatedAt

  externalMaintenanceRequest ExternalMaintenanceRequest @relation(fields: [externalMaintenanceRequestId], references: [id], onDelete: Cascade)

  @@index([externalMaintenanceRequestId])
  @@index([status])
  @@index([targetSystem])
  @@index([createdAt])
}

enum VehicleInternalStatus {
  NEW
  TO_REVIEW
  INTERESTING
  TO_CALL
  NEGOTIATION
  BOUGHT
  REJECTED
  EXPIRED
  PUBLISHED
}

enum DealerVehicleStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  HIDDEN
}

enum GarageRequestStatus {
  NEW
  IN_REVIEW
  WAITING_CLIENT
  QUOTE_READY
  QUOTE_SENT
  ACCEPTED
  REJECTED
  DONE
}

enum GarageRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ExternalMaintenanceSourceCompany {
  NOVOTRALUX
}

enum ExternalMaintenanceVehicleType {
  TRUCK
  TRAILER
}

enum ExternalMaintenanceInterventionType {
  DIAGNOSTIC
  TIRES
  BRAKES
  OIL_SERVICE
  ELECTRICAL
  BODYWORK
  TRAILER_REPAIR
  SAFETY_CHECK
  OTHER
}

enum ExternalMaintenanceUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ExternalMaintenanceStatus {
  RECEIVED
  UNDER_REVIEW
  MORE_INFO_REQUESTED
  QUOTE_PREPARING
  QUOTE_SENT
  QUOTE_APPROVED
  QUOTE_REJECTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INVOICED
  PAID
  CLOSED
  CANCELLED
}

enum ExternalMaintenanceWebhookTarget {
  NOVOTRALUX
}

enum ExternalMaintenanceWebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}
