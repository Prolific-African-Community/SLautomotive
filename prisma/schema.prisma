generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SourcingRule {
  id String @id @default(cuid())

  brand      String
  model      String
  yearMin    Int?
  yearMax    Int?
  priceMax   Float?
  mileageMax Int?

  countries String[] @default([])
  sources   String[] @default([])

  isActive Boolean @default(true)

  listings VehicleListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleListing {
  id String @id @default(cuid())

  source     String
  sourceUrl  String  @unique
  externalId String?

  brand       String
  model       String
  version     String?
  title       String?
  description String?

  year     Int?
  mileage  Int?
  price    Float?
  currency String @default("EUR")

  fuel         String?
  transmission String?
  power        String?
  location     String?
  country      String?

  imageUrl String?

  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  lastCheckedAt DateTime?

  isActive       Boolean               @default(true)
  internalStatus VehicleInternalStatus @default(NEW)

  sourcingRuleId String?
  sourcingRule   SourcingRule? @relation(fields: [sourcingRuleId], references: [id])

  analysis VehicleAnalysis?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleAnalysis {
  id String @id @default(cuid())

  listingId String         @unique
  listing   VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  purchaseTargetPrice Float?
  negotiationPrice    Float?

  repairCostEstimate Float?
  transportCost      Float?
  customsCost        Float?
  otherCosts         Float?

  expectedSalePrice Float?
  expectedMargin    Float?
  marginRate        Float?

  plannedWorks String?
  notes        String?

  priorityScore Int?
  isFavorite    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VehicleInternalStatus {
  NEW
  TO_REVIEW
  INTERESTING
  TO_CALL
  NEGOTIATION
  BOUGHT
  REJECTED
  EXPIRED
  PUBLISHED
}
