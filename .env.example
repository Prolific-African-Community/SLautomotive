DATABASE_URL=""
# Public base URL used in generated PDF links.
# Production: https://sl-automotive.vercel.app
# Local dev example: http://localhost:3002
SL_AUTOMOTIVE_PUBLIC_BASE_URL="https://sl-automotive.vercel.app"
# Production PDF storage requires either this token or a linked Vercel Blob
# store providing VERCEL_OIDC_TOKEN + BLOB_STORE_ID automatically.
# Local/dev falls back to public/generated/fees when Blob credentials are missing.
BLOB_READ_WRITE_TOKEN=""
NOVOTRALUX_API_KEY="shared-local-secret"
NOVOTRALUX_WEBHOOK_BASE_URL="http://localhost:3001"
NOVOTRALUX_WEBHOOK_API_KEY="shared-webhook-secret"
SL_DASHBOARD_USERNAME=""
SL_DASHBOARD_PASSWORD=""
SL_AUTH_SECRET=""
